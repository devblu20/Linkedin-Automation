# Phase 1 validates this variable's name but does not read or use its value.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
# The interactive OAuth flow must be completed as this account.
GOOGLE_EXPECTED_ACCOUNT=marketingcodex77@gmail.com

# Optional application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LINKEDIN_AUTOMATION_LOG_LEVEL=WARNING

# Primary database URL. Paste the Neon pooled connection string here.
# Keep sslmode=require. Never commit the real URL because it contains a password.
# LINKEDIN_AUTOMATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional local path fallback, used when DATABASE_URL is not set.
LINKEDIN_AUTOMATION_DATABASE=data/research.sqlite3
LINKEDIN_AUTOMATION_ARTIFACT_DIR=artifacts
LINKEDIN_AUTOMATION_BROWSER_DATA=browser-data
LINKEDIN_AUTOMATION_SCREENSHOT_DIR=screenshots
# Daily outbound caps are configured per YAML profile as max_daily_connections/messages.
# For Neon, set this to the same URL used above before running Alembic.
LINKEDIN_AUTOMATION_MIGRATION_URL=sqlite:///data/research.sqlite3
# Optional exact public HTTPS origin when proxying /linkedin-automation through Vercel.
# DASHBOARD_PUBLIC_ORIGIN=https://www.bluqq.com

# Optional restricted website login. Keep off until owner configuration is complete.
WEBSITE_AUTH_MODE=0
AUTH_PUBLIC_ORIGIN=https://www.bluqq.com
# Comma-separated exact addresses; empty denies all website users.
AUTH_EMAIL_ALLOWLIST=
# invite = owner-issued one-time code, no email service required (default).
# email = optional SMTP verification code signup.
# disabled = login only; no public registration pages or APIs.
AUTH_SIGNUP_MODE=disabled
# Website login credentials are separate from Google Drive integration above.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# STARTTLS SMTP for verified email/password signup (Google login works independently).
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=

# Optional no-install cloud research behind the EXISTING Google/admin login.
# Keep disabled until the owner key and real hosted LinkedIn connection are verified.
WEBSITE_CLOUD_MODE=0
CLOUD_OUTREACH_ENABLED=0
UNIPILE_API_VERSION=2
UNIPILE_API_URL=https://api.unipile.com
UNIPILE_API_KEY=
# V1 only: configure its exact DSN and a private 32+ character callback secret.
CLOUD_CALLBACK_SECRET=
# V2 multi-user setup requires an owner Service API key to manage private Scopes.
# A later key rotation in the SAME Unipile application needs an env update/restart,
# not a source change. A different application requires new account connections.

# Optional AI enhancements. Keys stay backend-only; normal research works without them.
# Choose openrouter OR openai; do not use a router key against the OpenAI endpoint.
MESSAGE_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
MESSAGE_AI_MODEL=google/gemini-2.5-flash
