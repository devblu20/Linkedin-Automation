# Phase 1 validates this variable's name but does not read or use its value.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
# The interactive OAuth flow must be completed as this account.
GOOGLE_EXPECTED_ACCOUNT=marketingcodex77@gmail.com

# Optional application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LINKEDIN_AUTOMATION_LOG_LEVEL=WARNING

# Primary database URL. Paste the Neon pooled connection string here.
# Keep sslmode=require. Never commit the real URL because it contains a password.
# LINKEDIN_AUTOMATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional local path fallback, used when DATABASE_URL is not set.
LINKEDIN_AUTOMATION_DATABASE=data/research.sqlite3
LINKEDIN_AUTOMATION_ARTIFACT_DIR=artifacts
LINKEDIN_AUTOMATION_BROWSER_DATA=browser-data
LINKEDIN_AUTOMATION_SCREENSHOT_DIR=screenshots
# Daily outbound caps are configured per YAML profile as max_daily_connections/messages.
# For Neon, set this to the same URL used above before running Alembic.
LINKEDIN_AUTOMATION_MIGRATION_URL=//neondb_owner:npg_64JnYjKgGVBs@ep-muddy-dawn-ay7rflof-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
